# Network RPC URLs
MAINNET_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/your-alchemy-key
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-alchemy-key
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-alchemy-key

# Private Keys - Keep these secret!
PRIVATE_KEY=0xyour_private_key_here
OWNER_PRIVATE_KEY=0xyour_owner_private_key_here

# API Keys for verification and gas reporting
ETHERSCAN_API_KEY=your-etherscan-api-key
POLYGONSCAN_API_KEY=your-polygonscan-api-key
ARBISCAN_API_KEY=your-arbiscan-api-key
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# Gas Reporter settings
REPORT_GAS=false
GAS_PRICE_API=https://api.etherscan.io/api?module=proxy&action=eth_gasPrice

# Deployment configuration
BLOCK_CONFIRMATIONS=3

# ArbitrageFlashLoan settings
ARBITRAGE_CONTRACT_ADDRESS=0xYourArbitrageContractAddress
FLASH_LOAN_CONTRACT_ADDRESS=0xYourFlashLoanContractAddress
BORROWED_TOKEN_ADDRESS=0xYourBorrowedTokenAddress   # e.g., USDC
TARGET_TOKEN_ADDRESS=0xYourTargetTokenAddress       # e.g., WETH
BORROW_AMOUNT=100                                   # Amount in full tokens
TOKEN_DECIMALS=6                                    # 6 for USDC, 18 for WETH, etc.
FEE_TIER_1=3000                                     # 0.3% Uniswap fee tier
FEE_TIER_2=3000                                     # 0.3% Uniswap fee tier
